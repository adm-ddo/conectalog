// ConectaLog — schema próprio, banco próprio, sem relação com o extras-app.
// Padrões (dois sistemas de auth separados, token de e-mail, blob privado
// pra foto/assinatura) replicados do extras-app por serem comprovados em
// produção lá — ver plano em C:\Users\Thiago\.claude\plans\recursive-munching-sundae.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleUsuario {
  MASTER
  GESTOR
}

enum TipoChavePix {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA
}

enum TipoTokenAutenticacao {
  VERIFICACAO_EMAIL
  RECUPERACAO_SENHA
}

enum FrequenciaPagamento {
  DIARIA
  SEMANAL
}

/// Turno fixo do motoboy — só informativo/organizacional (relatório separa
/// bandas de manhã vs. de noite quando ele faz os dois no mesmo dia).
enum TurnoPredefinido {
  MANHA
  NOITE
  LIVRE
}

enum StatusTurno {
  ABERTO
  CONCLUIDO
  PAGO
}

enum StatusPagamento {
  PENDENTE
  CONCLUIDO
}

enum TipoMeta {
  BANDAS
  VALOR
}

enum PeriodoMeta {
  SEMANAL
  MENSAL
  PERSONALIZADO
}

/// Equipamento de entrega que o motoboy usa — mostrado ao lado do nome
/// dele em toda tela (painel, portal do cliente) pra quem escala saber
/// se ele dá conta de pizza grande (baú 45cm) ou só entregas pequenas.
enum TipoEquipamento {
  BAG
  BAU_PEQUENO
  BAU_MEDIO
  BAU_GRANDE
}

/// Turno de uma escala — só manhã/noite (diferente de TurnoPredefinido,
/// que também tem LIVRE pro turno "avulso" fora de escala).
enum TurnoEscala {
  MANHA
  NOITE
}

/// Tenant — a cooperativa dona das motos. Cada Empresa é um cliente pagante
/// do ConectaLog (hoje só uma; o modelo já nasce multi-tenant pra revenda).
model Empresa {
  id                          Int      @id @default(autoincrement())
  nome                        String
  cnpj                        String?  @unique
  logoUrl                     String?
  /// Padrões usados quando o Cliente não tem valor próprio — cada um tem
  /// um lado "motoboy" (o que ele recebe) e um lado "cliente" (o que a
  /// cooperativa cobra da empresa cliente); a diferença é a margem da
  /// cooperativa. Não existe padrão de diária — isso é sempre negociado
  /// cliente a cliente, nunca teria um valor global que fizesse sentido.
  valorBandaMotoboyPadrao     Decimal  @default(0) @db.Decimal(10, 2)
  valorBandaClientePadrao     Decimal  @default(0) @db.Decimal(10, 2)
  valorTaxaExtraMotoboyPadrao Decimal  @default(0) @db.Decimal(10, 2)
  valorTaxaExtraClientePadrao Decimal  @default(0) @db.Decimal(10, 2)
  /// Link fixo de cadastro pro motoboy (/app/cadastro/[token]) — quem se
  /// cadastra por esse link já entra credenciado nesta cooperativa
  /// direto, sem precisar de aprovação. Gerado automaticamente na
  /// criação da Empresa. Modelo "descobrir e solicitar credenciamento
  /// noutra cooperativa" fica pra uma fase futura — ver conversa com o
  /// Thiago sobre o motoboy como perfil global no ConectaLog.
  tokenCadastroMotoboy        String?  @unique
  criadoEm                    DateTime @default(now())

  usuarios      Usuario[]
  clientes      Cliente[]
  motoboys      Motoboy[]
  pagamentos    Pagamento[]
  vales         Vale[]
  convites      ConviteEquipe[]
  sessoesAtivas Sessao[]
}

/// Login do painel (dono/gestor da cooperativa) — sistema de sessão
/// deliberadamente separado do login do Motoboy (auth-motoboy.ts), mesmo
/// espírito do extras-app: uma falha num nunca deve derrubar o outro.
model Usuario {
  id                Int         @id @default(autoincrement())
  empresaId         Int
  nome              String
  email             String      @unique
  senhaHash         String
  role              RoleUsuario @default(GESTOR)
  /// Dono da plataforma ConectaLog (não confundir com role MASTER, que é
  /// só o dono de UMA cooperativa) — enxerga todas as cooperativas
  /// cadastradas e pode "entrar" em qualquer uma como se fosse o dono
  /// dela (ver Sessao.empresaAtivaId e requireTenant em
  /// src/lib/auth-empresa.ts). Nunca setado por autocadastro.
  superAdmin        Boolean     @default(false)
  /// null até confirmar o cadastro pelo link de e-mail (só se aplica a
  /// quem se cadastrou sozinho, ou seja, o primeiro MASTER de cada
  /// cooperativa) — GESTOR convidado já entra verificado, porque clicar
  /// no link de convite já prova posse do e-mail.
  emailVerificadoEm DateTime?
  ativo             Boolean     @default(true)
  criadoEm          DateTime    @default(now())

  empresa                      Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sessoes                      Sessao[]
  vales                        Vale[]
  escalasCriadas               EscalaTurno[]
  solicitacoesApoioRespondidas SolicitacaoApoio[]
  tokensAutenticacao           TokenAutenticacaoUsuario[]
  convitesEnviados             ConviteEquipe[]
}

/// Token de uso único (verificação de e-mail / recuperação de senha) do
/// Usuario — espelha TokenAutenticacaoMotoboy, mesmo motivo de tabela
/// própria (nunca misturar com a sessão/token de outro sistema de auth).
model TokenAutenticacaoUsuario {
  id        Int                   @id @default(autoincrement())
  token     String                @unique
  usuarioId Int
  tipo      TipoTokenAutenticacao
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime              @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
}

/// Convite pra alguém entrar na equipe do painel (role GESTOR) — o
/// MASTER manda pra um e-mail, a pessoa clica no link e define a
/// própria senha. Diferente do extras-app (que cria o login pronto na
/// hora, sem convite real por e-mail): aqui é convite de verdade,
/// porque agora existe infraestrutura de e-mail (Resend) pra isso.
model ConviteEquipe {
  id                 Int       @id @default(autoincrement())
  empresaId          Int
  email              String
  token              String    @unique
  criadoPorUsuarioId Int
  expiraEm           DateTime
  aceitoEm           DateTime?
  criadoEm           DateTime  @default(now())

  empresa          Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  criadoPorUsuario Usuario @relation(fields: [criadoPorUsuarioId], references: [id])

  @@index([empresaId])
}

model Sessao {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  usuarioId      Int
  /// Só usado por Usuario.superAdmin — qual cooperativa ele "entrou"
  /// pra ver/mexer como se fosse o dono dela. null = ainda não entrou em
  /// nenhuma (aí a tela é a lista de cooperativas, ver /master).
  empresaAtivaId Int?
  criadoEm       DateTime @default(now())
  expiraEm       DateTime

  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaAtiva Empresa? @relation(fields: [empresaAtivaId], references: [id], onDelete: SetNull)
}

/// Empresa cliente atendida pela cooperativa. Tem dois modelos de preço
/// possíveis, configuráveis de forma independente (ver src/lib/precificacao.ts):
/// (1) "por banda" simples — sempre disponível, usado quando não há diária;
/// (2) "diária"/franquia — opcional (liga quando valorDiariaMotoboy não é
/// nulo): a cooperativa cobra um fixo por moto/dia que já inclui N bandas,
/// e bandas além da franquia usam uma tarifa própria (excedente),
/// diferente da tarifa "normal". Cada valor tem lado motoboy (o que ele
/// recebe) e lado cliente (o que a cooperativa cobra da empresa) — a
/// diferença é a margem da cooperativa.
model Cliente {
  id        Int      @id @default(autoincrement())
  empresaId Int
  nome      String
  endereco  String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  // Acesso do cliente ao próprio portal — mesmo padrão do Totem do
  // extras-app: um token na URL (/portal/[token]/...), sem login/senha.
  // A cooperativa gera o link ao cadastrar o cliente e manda pra ele
  // deixar aberto/salvo no navegador. null = link ainda não gerado.
  tokenPortal String? @unique

  // Horários dos turnos fixos e quantidade de motos contratada em cada um
  // — usado pro alerta de "equipe incompleta" no dashboard da cooperativa.
  // motosFixasManha/Noite: 7 posições, índice = Date.getDay() (0=domingo
  // ... 6=sábado), porque a demanda de moto fixa varia por dia da semana
  // (ex.: sexta/sábado pedem mais moto que uma terça).
  turnoManhaAtivo  Boolean @default(false)
  turnoManhaInicio String?
  turnoManhaFim    String?
  motosFixasManha  Int[]   @default([0, 0, 0, 0, 0, 0, 0])
  turnoNoiteAtivo  Boolean @default(false)
  turnoNoiteInicio String?
  turnoNoiteFim    String?
  motosFixasNoite  Int[]   @default([0, 0, 0, 0, 0, 0, 0])

  // Preço "por banda" normal — null herda o padrão da Empresa.
  valorBandaMotoboy     Decimal? @db.Decimal(10, 2)
  valorBandaCliente     Decimal? @db.Decimal(10, 2)
  valorTaxaExtraMotoboy Decimal? @db.Decimal(10, 2)
  valorTaxaExtraCliente Decimal? @db.Decimal(10, 2)

  // Diária/franquia — opcional; null em valorDiariaMotoboy = cliente não
  // usa esse modelo, cai no "por banda" normal acima.
  valorDiariaMotoboy         Decimal? @db.Decimal(10, 2)
  valorDiariaCliente         Decimal? @db.Decimal(10, 2)
  bandasIncluidasNaDiaria    Int?
  valorBandaExcedenteMotoboy Decimal? @db.Decimal(10, 2)
  valorBandaExcedenteCliente Decimal? @db.Decimal(10, 2)

  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  motoboysLiberados MotoboyCliente[]
  turnos            Turno[]
  apoios            Apoio[]
  escalas           EscalaTurno[]
  avaliacoes        Avaliacao[]
  ocorrencias       Ocorrencia[]
  solicitacoesApoio SolicitacaoApoio[]

  @@index([empresaId])
}

/// Escala manual: a cooperativa decide que Motoboy vai trabalhar em qual
/// Cliente, em qual data/turno. turnoId é preenchido quando o motoboy de
/// fato bate o início do turno correspondente — é isso que faz o card
/// virar verde no portal do cliente e no painel da cooperativa.
model EscalaTurno {
  id                 Int         @id @default(autoincrement())
  clienteId          Int
  motoboyId          Int
  data               DateTime    @db.Date
  turno              TurnoEscala
  turnoId            Int?
  criadoPorUsuarioId Int
  criadoEm           DateTime    @default(now())

  cliente          Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motoboy          Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  turnoVinculado   Turno?  @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  criadoPorUsuario Usuario @relation(fields: [criadoPorUsuarioId], references: [id])

  @@unique([clienteId, motoboyId, data, turno])
  @@index([clienteId, data])
}

/// O motoboy — cadastro próprio (Portal-like) ou criado manualmente pela
/// cooperativa. senhaHash fica null até ele definir a senha pelo link de
/// verificação de e-mail (mesmo fluxo do Portal do extras-app).
model Motoboy {
  id                  Int                 @id @default(autoincrement())
  empresaId           Int
  nomeCompleto        String
  dataNascimento      DateTime            @db.Date
  cpf                 String              @unique
  email               String              @unique
  endereco            String
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  cep                 String?
  telefoneCelular     String
  telefoneEmergencia  String
  chavePix            String
  tipoChavePix        TipoChavePix
  /// Selfie tirada na hora (CameraCapture, sem upload de galeria) — mesmo
  /// motivo do extras-app: a cooperativa precisa saber que é uma foto
  /// atual de verdade, não uma foto de anos atrás.
  fotoPerfilUrl       String?
  /// CNH aceita foto ao vivo OU anexo de arquivo — ao contrário da selfie,
  /// que é sempre ao vivo (decisão confirmada com o Thiago).
  cnhFotoUrl          String?
  senhaHash           String?
  emailVerificadoEm   DateTime?
  /// Mostrado ao lado do nome dele em toda tela (painel e portal do
  /// cliente) — null = ainda não informado.
  tipoEquipamento     TipoEquipamento?
  frequenciaPagamento FrequenciaPagamento @default(SEMANAL)
  /// true = pode iniciar turno em qualquer Cliente ativo da cooperativa,
  /// sem precisar de liberação individual em MotoboyCliente.
  livre               Boolean             @default(false)
  ativo               Boolean             @default(true)
  criadoEm            DateTime            @default(now())

  empresa            Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clientesLiberados  MotoboyCliente[]
  turnos             Turno[]
  pagamentos         Pagamento[]
  vales              Vale[]
  metas              Meta[]
  sessoes            SessaoMotoboy[]
  tokensAutenticacao TokenAutenticacaoMotoboy[]
  escalas            EscalaTurno[]
  avaliacoes         Avaliacao[]
  ocorrencias        Ocorrencia[]

  @@index([empresaId])
}

/// Sessão de login do Motoboy no app — separada de Sessao (login do
/// painel), mesmo espírito de SessaoPessoa no extras-app.
model SessaoMotoboy {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  motoboyId Int
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
}

/// Token de uso único (verificação de e-mail / recuperação de senha) do
/// Motoboy — espelha TokenAutenticacaoPessoa do extras-app.
model TokenAutenticacaoMotoboy {
  id        Int                   @id @default(autoincrement())
  token     String                @unique
  motoboyId Int
  tipo      TipoTokenAutenticacao
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime              @default(now())

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)

  @@index([motoboyId, tipo])
}

/// Autorização explícita: este motoboy pode iniciar turno neste Cliente.
/// Diferente do extras-app (vínculo aberto, criado no primeiro check-in),
/// aqui a cooperativa precisa liberar antes — decisão confirmada com o
/// Thiago. Não existe linha aqui = não autorizado (a não ser que
/// Motoboy.livre seja true).
model MotoboyCliente {
  id        Int      @id @default(autoincrement())
  motoboyId Int
  clienteId Int
  liberado  Boolean  @default(true)
  criadoEm  DateTime @default(now())

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([motoboyId, clienteId])
}

/// Um turno do motoboy num Cliente: foto+assinatura de início, foto+
/// assinatura de recibo no fim, quantidade de bandas e taxas extras
/// (ambos via stepper +/- na UI) informadas no fechamento. valorBandaAplicado/
/// valorTaxaExtraAplicado são o snapshot do valor no momento do fechamento —
/// não recalcula se o preço do Cliente mudar depois (mesmo motivo do
/// extras-app: histórico não pode mudar retroativamente).
model Turno {
  id                     Int              @id @default(autoincrement())
  motoboyId              Int
  clienteId              Int
  turnoPredefinido       TurnoPredefinido @default(LIVRE)
  horaInicio             DateTime         @default(now())
  horaFim                DateTime?
  fotoInicioUrl          String
  fotoFimUrl             String?
  assinaturaTermoUrl     String
  assinaturaReciboUrl    String?
  quantidadeBandas       Int              @default(0)
  quantidadeTaxasExtras  Int              @default(0)
  valorBandaAplicado     Decimal?         @db.Decimal(10, 2)
  valorTaxaExtraAplicado Decimal?         @db.Decimal(10, 2)
  /// O que o MOTOBOY recebe (sempre existiu). valorCobradoCliente é o que
  /// a COOPERATIVA cobra da empresa cliente por esse turno — pode ser
  /// maior (margem da cooperativa); ver src/lib/precificacao.ts.
  valorTotal             Decimal?         @db.Decimal(10, 2)
  valorCobradoCliente    Decimal?         @db.Decimal(10, 2)
  status                 StatusTurno      @default(ABERTO)
  pagamentoId            Int?
  criadoEm               DateTime         @default(now())

  /// Contagem que o CLIENTE (restaurante) informa pelo portal ao
  /// encerrar o motoboy do lado dele — null enquanto ele não fechou.
  /// Quando os dois números não batem (quantidadeBandas do motoboy vs.
  /// quantidadeBandasCliente), o turno fica marcado como divergente até
  /// a cooperativa resolver manualmente (ver resolvidoDivergenciaEm) —
  /// decisão confirmada com o Thiago: os dois têm que bater, não é o
  /// registro de um lado que automaticamente vale mais que o outro.
  quantidadeBandasCliente      Int?
  quantidadeTaxasExtrasCliente Int?
  /// Preenchido quando a cooperativa resolve manualmente uma divergência
  /// (ou confirma que os números batem) — enquanto null e os dois
  /// números existirem e forem diferentes, o turno aparece na tela de
  /// divergências do painel.
  resolvidoDivergenciaEm       DateTime?

  motoboy    Motoboy       @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  cliente    Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pagamento  Pagamento?    @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)
  apoios     Apoio[]
  escalas    EscalaTurno[]
  avaliacao  Avaliacao?
  ocorrencia Ocorrencia?

  @@index([motoboyId, status])
  @@index([clienteId, status])
}

/// Avaliação do motoboy pelo cliente (restaurante) ao encerrar o turno
/// dele do lado do portal — nota de 1 a 5 + comentário livre opcional,
/// pra registrar qualquer ocorrência.
model Avaliacao {
  id         Int      @id @default(autoincrement())
  turnoId    Int      @unique
  clienteId  Int
  motoboyId  Int
  nota       Int
  comentario String?
  criadoEm   DateTime @default(now())

  turno   Turno   @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)

  @@index([motoboyId])
}

/// Ocorrência registrada pelo cliente ao encerrar o turno do motoboy —
/// pedido com problema, cobrança não feita, dinheiro não devolvido,
/// entrega que chegou errada por responsabilidade dele etc. A descrição
/// é o log do motivo; valorDesconto é abatido de verdade do que o
/// motoboy recebe (ver fecharPagamento em
/// src/app/(painel)/pagamentos/actions.ts) — diferente da Avaliação
/// (nota/comentário), que é só histórico e não mexe em dinheiro.
model Ocorrencia {
  id            Int      @id @default(autoincrement())
  turnoId       Int      @unique
  clienteId     Int
  motoboyId     Int
  descricao     String   @db.Text
  valorDesconto Decimal  @db.Decimal(10, 2)
  pagamentoId   Int?
  criadoEm      DateTime @default(now())

  turno     Turno      @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motoboy   Motoboy    @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  pagamento Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)

  @@index([motoboyId])
}

enum StatusSolicitacaoApoio {
  PENDENTE
  A_CAMINHO
  SEM_MOTO
}

/// Pedido de apoio feito pelo cliente direto no portal — a cooperativa
/// vê isso na hora no painel (alerta) e responde com um dos dois botões.
model SolicitacaoApoio {
  id                     Int                    @id @default(autoincrement())
  clienteId              Int
  quantidade             Int
  status                 StatusSolicitacaoApoio @default(PENDENTE)
  respondidoPorUsuarioId Int?
  respondidoEm           DateTime?
  criadoEm               DateTime               @default(now())

  cliente              Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  respondidoPorUsuario Usuario? @relation(fields: [respondidoPorUsuarioId], references: [id])

  @@index([clienteId, status])
}

/// Apoio: o motoboy ajuda outro Cliente durante/depois do turno principal.
/// Sem foto/assinatura de propósito (decisão confirmada com o Thiago) —
/// só marca o Cliente de apoio e a quantidade, pra não atrapalhar o fluxo
/// dele no meio da correria.
model Apoio {
  id                     Int      @id @default(autoincrement())
  turnoId                Int
  clienteId              Int
  quantidadeBandas       Int      @default(0)
  quantidadeTaxasExtras  Int      @default(0)
  valorBandaAplicado     Decimal  @db.Decimal(10, 2)
  valorTaxaExtraAplicado Decimal  @db.Decimal(10, 2)
  valorTotal             Decimal  @db.Decimal(10, 2)
  valorCobradoCliente    Decimal  @default(0) @db.Decimal(10, 2)
  pagamentoId            Int?
  criadoEm               DateTime @default(now())

  turno     Turno      @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pagamento Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)

  @@index([turnoId])
}

/// Pagamento de um período pra um motoboy — bookkeeping manual (a
/// cooperativa faz o PIX pelo banco dela e marca aqui como pago), mesmo
/// modelo do extras-app: sem integração PIX automática no MVP.
model Pagamento {
  id            Int             @id @default(autoincrement())
  motoboyId     Int
  empresaId     Int
  periodoInicio DateTime        @db.Date
  periodoFim    DateTime        @db.Date
  valorTotal    Decimal         @db.Decimal(10, 2)
  status        StatusPagamento @default(PENDENTE)
  pagoEm        DateTime?
  criadoEm      DateTime        @default(now())

  motoboy     Motoboy      @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  turnos      Turno[]
  apoios      Apoio[]
  ocorrencias Ocorrencia[]

  @@index([motoboyId, status])
}

/// Vale (adiantamento) dado pela cooperativa a um motoboy — aparece no app
/// dele como valor a compensar no próximo pagamento.
model Vale {
  id                 Int       @id @default(autoincrement())
  motoboyId          Int
  empresaId          Int
  valor              Decimal   @db.Decimal(10, 2)
  data               DateTime  @default(now()) @db.Date
  observacao         String?
  /// Preenchido quando a cooperativa já compensou esse vale no pagamento
  /// (manualmente — não há vínculo automático com Pagamento nesta fase).
  descontadoEm       DateTime?
  criadoPorUsuarioId Int
  criadoEm           DateTime  @default(now())

  motoboy          Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  empresa          Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  criadoPorUsuario Usuario @relation(fields: [criadoPorUsuarioId], references: [id])

  @@index([motoboyId])
}

/// Meta pessoal do motoboy (bandas ou valor-alvo num período) — puramente
/// motivacional, sem efeito em pagamento. Progresso calculado a partir de
/// Turno+Apoio no período, não armazenado aqui.
model Meta {
  id            Int         @id @default(autoincrement())
  motoboyId     Int
  tipo          TipoMeta
  valorAlvo     Decimal     @db.Decimal(10, 2)
  periodoTipo   PeriodoMeta @default(SEMANAL)
  periodoInicio DateTime    @db.Date
  periodoFim    DateTime    @db.Date
  ativa         Boolean     @default(true)
  criadoEm      DateTime    @default(now())

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)

  @@index([motoboyId, ativa])
}
