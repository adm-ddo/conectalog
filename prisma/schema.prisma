// ConectaLog — schema próprio, banco próprio, sem relação com o extras-app.
// Padrões (dois sistemas de auth separados, token de e-mail, blob privado
// pra foto/assinatura) replicados do extras-app por serem comprovados em
// produção lá — ver plano em C:\Users\Thiago\.claude\plans\recursive-munching-sundae.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleUsuario {
  MASTER
  GESTOR
  /// Motoboy promovido a Gestor de campo (ver Motoboy.ehGestor) — login de
  /// painel pareado com um Motoboy (Usuario.motoboyVinculadoId), acesso
  /// bem mais restrito que GESTOR normal: só dashboard/escala/equipe dos
  /// clientes que ele é responsável (ver MotoboyCliente.gestor), nunca
  /// outros clientes, pagamentos, relatórios, equipe (convites) ou
  /// configurações.
  GESTOR_CAMPO
}

enum ModoRemuneracaoGestor {
  PADRAO
  VALOR_ESPECIAL
  NAO_CONTABILIZA
}

enum TipoChavePix {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA
}

enum TipoTokenAutenticacao {
  VERIFICACAO_EMAIL
  RECUPERACAO_SENHA
}

enum FrequenciaPagamento {
  DIARIA
  SEMANAL
}

/// Turno fixo do motoboy — só informativo/organizacional (relatório separa
/// bandas de manhã vs. de noite quando ele faz os dois no mesmo dia).
enum TurnoPredefinido {
  MANHA
  TARDE
  NOITE
  LIVRE
}

enum StatusTurno {
  ABERTO
  CONCLUIDO
  PAGO
}

enum StatusPagamento {
  PENDENTE
  CONCLUIDO
}

enum TipoMeta {
  BANDAS
  VALOR
}

enum PeriodoMeta {
  DIARIA
  SEMANAL
  MENSAL
  PERSONALIZADO
}

/// Equipamento de entrega que o motoboy usa — mostrado ao lado do nome
/// dele em toda tela (painel, portal do cliente) pra quem escala saber
/// se ele dá conta de pizza grande (baú 45cm) ou só entregas pequenas.
enum TipoEquipamento {
  BAG
  BAU_PEQUENO
  BAU_MEDIO
  BAU_GRANDE
}

/// Turno de uma escala — só manhã/noite (diferente de TurnoPredefinido,
/// que também tem LIVRE pro turno "avulso" fora de escala).
enum TurnoEscala {
  MANHA
  TARDE
  NOITE
}

/// Tenant — a cooperativa dona das motos. Cada Empresa é um cliente pagante
/// do ConectaLog (hoje só uma; o modelo já nasce multi-tenant pra revenda).
model Empresa {
  id                       Int      @id @default(autoincrement())
  nome                     String
  cnpj                     String?  @unique
  logoUrl                  String?
  /// Padrão de banda usado quando o Cliente não tem valor próprio — lado
  /// "motoboy" (o que ele recebe) e lado "cliente" (o que a cooperativa
  /// cobra da empresa cliente); a diferença é a margem da cooperativa.
  /// Não existe padrão de diária nem de taxa extra: diária é sempre
  /// negociada cliente a cliente, e taxa extra virou uma lista própria de
  /// cada Cliente (ver ClienteTaxaExtra) — não faria sentido um valor
  /// único global quando cada empresa cliente cobra por faixas de
  /// distância diferentes.
  valorBandaMotoboyPadrao  Decimal  @default(0) @db.Decimal(10, 2)
  valorBandaClientePadrao  Decimal  @default(0) @db.Decimal(10, 2)
  /// Link fixo de cadastro pro motoboy (/app/cadastro/[token]) — quem se
  /// cadastra por esse link já entra credenciado nesta cooperativa
  /// direto, sem precisar de aprovação. Gerado automaticamente na
  /// criação da Empresa. Modelo "descobrir e solicitar credenciamento
  /// noutra cooperativa" fica pra uma fase futura — ver conversa com o
  /// Thiago sobre o motoboy como perfil global no ConectaLog.
  tokenCadastroMotoboy     String?  @unique
  /// Desconto automático de assiduidade (ver Motoboy.descontoAssiduidadeAtivo
  /// e DescontoAssiduidade) — quanto de tolerância (minutos) o motoboy tem
  /// depois do horário configurado do turno no Cliente antes de o atraso
  /// gerar desconto, e quanto desconta pra cada turno (cada um com seu
  /// valor, personalizável aqui).
  toleranciaAtrasoMinutos  Int      @default(30)
  valorDescontoAtrasoManha Decimal  @default(15) @db.Decimal(10, 2)
  valorDescontoAtrasoTarde Decimal  @default(10) @db.Decimal(10, 2)
  valorDescontoAtrasoNoite Decimal  @default(20) @db.Decimal(10, 2)
  /// false = some da lista de cooperativas que o motoboy "na prateleira"
  /// vê pra solicitar vaga (ver app/(logado)/layout.tsx) — pra
  /// cooperativas de teste/internas que não devem aparecer pra
  /// motoboy nenhum. Não afeta quem já está vinculado a ela nem o link
  /// direto de cadastro (tokenCadastroMotoboy).
  visivelParaCadastro      Boolean  @default(true)
  criadoEm                 DateTime @default(now())

  usuarios      Usuario[]
  clientes      Cliente[]
  motoboys      Motoboy[]
  pagamentos    Pagamento[]
  vales         Vale[]
  convites      ConviteEquipe[]
  sessoesAtivas Sessao[]
}

/// Login do painel (dono/gestor da cooperativa) — sistema de sessão
/// deliberadamente separado do login do Motoboy (auth-motoboy.ts), mesmo
/// espírito do extras-app: uma falha num nunca deve derrubar o outro.
model Usuario {
  id                 Int         @id @default(autoincrement())
  empresaId          Int
  nome               String
  email              String      @unique
  senhaHash          String
  role               RoleUsuario @default(GESTOR)
  /// Dono da plataforma ConectaLog (não confundir com role MASTER, que é
  /// só o dono de UMA cooperativa) — enxerga todas as cooperativas
  /// cadastradas e pode "entrar" em qualquer uma como se fosse o dono
  /// dela (ver Sessao.empresaAtivaId e requireTenant em
  /// src/lib/auth-empresa.ts). Nunca setado por autocadastro.
  superAdmin         Boolean     @default(false)
  /// null até confirmar o cadastro pelo link de e-mail (só se aplica a
  /// quem se cadastrou sozinho, ou seja, o primeiro MASTER de cada
  /// cooperativa) — GESTOR convidado já entra verificado, porque clicar
  /// no link de convite já prova posse do e-mail.
  emailVerificadoEm  DateTime?
  ativo              Boolean     @default(true)
  criadoEm           DateTime    @default(now())
  /// Só preenchido pra role GESTOR_CAMPO — este login de painel foi
  /// criado automaticamente quando um Motoboy virou Gestor (ver
  /// Motoboy.ehGestor). Mesma pessoa, dois logins de verdade e isolados,
  /// só ligados por essa referência.
  motoboyVinculadoId Int?        @unique

  empresa                      Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  motoboyVinculado             Motoboy?                   @relation(fields: [motoboyVinculadoId], references: [id], onDelete: Cascade)
  sessoes                      Sessao[]
  vales                        Vale[]
  escalasCriadas               EscalaTurno[]
  solicitacoesApoioRespondidas SolicitacaoApoio[]
  tokensAutenticacao           TokenAutenticacaoUsuario[]
  convitesEnviados             ConviteEquipe[]
  divergenciasResolvidas       Turno[]                    @relation("TurnoResolvidoPor")
}

/// Token de uso único (verificação de e-mail / recuperação de senha) do
/// Usuario — espelha TokenAutenticacaoMotoboy, mesmo motivo de tabela
/// própria (nunca misturar com a sessão/token de outro sistema de auth).
model TokenAutenticacaoUsuario {
  id        Int                   @id @default(autoincrement())
  token     String                @unique
  usuarioId Int
  tipo      TipoTokenAutenticacao
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime              @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
}

/// Convite pra alguém entrar na equipe do painel (role GESTOR) — o
/// MASTER manda pra um e-mail, a pessoa clica no link e define a
/// própria senha. Diferente do extras-app (que cria o login pronto na
/// hora, sem convite real por e-mail): aqui é convite de verdade,
/// porque agora existe infraestrutura de e-mail (Resend) pra isso.
model ConviteEquipe {
  id                 Int       @id @default(autoincrement())
  empresaId          Int
  email              String
  token              String    @unique
  criadoPorUsuarioId Int
  expiraEm           DateTime
  aceitoEm           DateTime?
  criadoEm           DateTime  @default(now())

  empresa          Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  criadoPorUsuario Usuario @relation(fields: [criadoPorUsuarioId], references: [id])

  @@index([empresaId])
}

model Sessao {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  usuarioId      Int
  /// Só usado por Usuario.superAdmin — qual cooperativa ele "entrou"
  /// pra ver/mexer como se fosse o dono dela. null = ainda não entrou em
  /// nenhuma (aí a tela é a lista de cooperativas, ver /master).
  empresaAtivaId Int?
  criadoEm       DateTime @default(now())
  expiraEm       DateTime

  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaAtiva Empresa? @relation(fields: [empresaAtivaId], references: [id], onDelete: SetNull)
}

/// Empresa cliente atendida pela cooperativa. Tem dois modelos de preço
/// possíveis, configuráveis de forma independente (ver src/lib/precificacao.ts):
/// (1) "por banda" simples — sempre disponível, usado quando nenhum
/// ClienteTurnoFixo bate com o turno; (2) "valor fixo por turno" — cada
/// perfil em ClienteTurnoFixo cobre um horário + dias da semana com um
/// valor garantido que já inclui N bandas, e bandas além disso usam uma
/// tarifa de excedente própria. Cada valor tem lado motoboy (o que ele
/// recebe) e lado cliente (o que a cooperativa cobra da empresa) — a
/// diferença é a margem da cooperativa.
model Cliente {
  id        Int      @id @default(autoincrement())
  empresaId Int
  nome      String
  endereco  String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  // Acesso do cliente ao próprio portal — mesmo padrão do Totem do
  // extras-app: um token na URL (/portal/[token]/...), sem login/senha.
  // A cooperativa gera o link ao cadastrar o cliente e manda pra ele
  // deixar aberto/salvo no navegador. null = link ainda não gerado.
  tokenPortal String? @unique

  // Horários dos turnos fixos e quantidade de motos contratada em cada um
  // — usado pro alerta de "equipe incompleta" no dashboard da cooperativa.
  // motosFixasManha/Tarde/Noite: 7 posições, índice = Date.getDay()
  // (0=domingo...6=sábado), porque a demanda de moto fixa varia por dia
  // da semana (ex.: sexta/sábado pedem mais moto que uma terça).
  turnoManhaAtivo  Boolean @default(false)
  turnoManhaInicio String?
  turnoManhaFim    String?
  motosFixasManha  Int[]   @default([0, 0, 0, 0, 0, 0, 0])
  turnoTardeAtivo  Boolean @default(false)
  turnoTardeInicio String?
  turnoTardeFim    String?
  motosFixasTarde  Int[]   @default([0, 0, 0, 0, 0, 0, 0])
  turnoNoiteAtivo  Boolean @default(false)
  turnoNoiteInicio String?
  turnoNoiteFim    String?
  motosFixasNoite  Int[]   @default([0, 0, 0, 0, 0, 0, 0])

  // Preço "por banda" normal — null herda o padrão da Empresa. Nem taxa
  // extra nem "valor fixo por turno" são um valor único: cada Cliente tem
  // sua própria lista (ver ClienteTaxaExtra e ClienteTurnoFixo), porque
  // cada empresa cliente cobra de um jeito diferente.
  valorBandaMotoboy Decimal? @db.Decimal(10, 2)
  valorBandaCliente Decimal? @db.Decimal(10, 2)

  empresa             Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  motoboysLiberados   MotoboyCliente[]
  turnos              Turno[]
  apoios              Apoio[]
  escalas             EscalaTurno[]
  avaliacoes          Avaliacao[]
  avaliacoesRecebidas AvaliacaoCliente[]
  ocorrencias         Ocorrencia[]
  solicitacoesApoio   SolicitacaoApoio[]
  taxasExtras         ClienteTaxaExtra[]
  turnosFixos         ClienteTurnoFixo[]

  @@index([empresaId])
}

/// Uma faixa de taxa extra do Cliente (ex.: "Taxa 1 — 6,1 a 9km", "Taxa 2
/// — 9,1 a 12km"...) — cada cooperativa/cliente define suas próprias
/// faixas e valores, por isso é uma lista e não um valor fixo. `ordem`
/// decide a exibição (Taxa 1, Taxa 2...) e pode ser reordenada; a
/// `descricao` é o texto livre que explica do que se trata a faixa.
model ClienteTaxaExtra {
  id           Int      @id @default(autoincrement())
  clienteId    Int
  ordem        Int
  descricao    String
  valorMotoboy Decimal  @db.Decimal(10, 2)
  valorCliente Decimal  @db.Decimal(10, 2)
  criadoEm     DateTime @default(now())

  cliente    Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  itensTurno TurnoTaxaExtraItem[]
  itensApoio ApoioTaxaExtraItem[]

  @@index([clienteId])
}

/// Um perfil de "valor fixo por turno" do Cliente — cobre um horário
/// (`horaInicio`-`horaFim`) e um conjunto de dias da semana
/// (`diasSemana`: 0=domingo...6=sábado). Turno que bater com o horário E
/// o dia da semana de algum perfil usa o valor garantido dele (que já
/// inclui `bandasIncluidas` bandas, excedente cobrado à parte); turno que
/// não bater com nenhum perfil cai no "por banda" normal do Cliente. Como
/// é uma lista, o mesmo turno (ex.: "Noite") pode ter um perfil pros dias
/// de semana normais e outro só pro domingo, com valores diferentes.
model ClienteTurnoFixo {
  id                    Int      @id @default(autoincrement())
  clienteId             Int
  nome                  String
  horaInicio            String
  horaFim               String
  diasSemana            Int[]
  valorGarantidoMotoboy Decimal  @db.Decimal(10, 2)
  valorGarantidoCliente Decimal  @db.Decimal(10, 2)
  bandasIncluidas       Int
  valorExcedenteMotoboy Decimal  @db.Decimal(10, 2)
  valorExcedenteCliente Decimal  @db.Decimal(10, 2)
  /// false (padrão): cliente paga valorExcedenteCliente sobre TODAS as
  /// bandas do turno, desde a primeira, sem carência — modelo confirmado
  /// pra KERO SUSHI e Turi gastronomia. true: cliente ganha carência
  /// igual em espírito à do motoboy, mas com seu PRÓPRIO número de
  /// entregas incluídas (bandasIncluidasCliente, independente de
  /// bandasIncluidas do motoboy — tem cliente que a cooperativa garante
  /// só 9 pro cliente mas 10 pro motoboy) — valorGarantidoCliente já
  /// cobre bandasIncluidasCliente e só as que passarem disso são
  /// cobradas, a valorExcedenteCliente cada uma (ver
  /// src/lib/precificacao.ts).
  carenciaCliente       Boolean  @default(false)
  /// Só é usado quando carenciaCliente=true — ver comentário acima.
  bandasIncluidasCliente Int     @default(0)
  criadoEm              DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

/// Escala manual: a cooperativa decide que Motoboy vai trabalhar em qual
/// Cliente, em qual data/turno. turnoId é preenchido quando o motoboy de
/// fato bate o início do turno correspondente — é isso que faz o card
/// virar verde no portal do cliente e no painel da cooperativa.
model EscalaTurno {
  id                 Int         @id @default(autoincrement())
  clienteId          Int
  motoboyId          Int
  data               DateTime    @db.Date
  turno              TurnoEscala
  turnoId            Int?
  criadoPorUsuarioId Int
  criadoEm           DateTime    @default(now())

  cliente          Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motoboy          Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  turnoVinculado   Turno?  @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  criadoPorUsuario Usuario @relation(fields: [criadoPorUsuarioId], references: [id])

  @@unique([clienteId, motoboyId, data, turno])
  @@index([clienteId, data])
}

/// O motoboy — cadastro próprio (Portal-like) ou criado manualmente pela
/// cooperativa. senhaHash fica null até ele definir a senha pelo link de
/// verificação de e-mail (mesmo fluxo do Portal do extras-app).
model Motoboy {
  id                       Int                   @id @default(autoincrement())
  /// null = ainda não escolheu nenhuma cooperativa — só acontece pra quem
  /// se cadastra pelo app sem link (ver solicitarVagaMotoboy), entre a
  /// confirmação de e-mail e a escolha feita depois do primeiro login em
  /// /app/escolher-cooperativa. Quem se cadastra por link direto da
  /// cooperativa ou é cadastrado manualmente já nasce com isso setado.
  empresaId                Int?
  nomeCompleto             String
  dataNascimento           DateTime              @db.Date
  cpf                      String                @unique
  email                    String                @unique
  endereco                 String
  numero                   String?
  complemento              String?
  bairro                   String?
  cidade                   String?
  cep                      String?
  telefoneCelular          String
  telefoneEmergencia       String
  chavePix                 String
  tipoChavePix             TipoChavePix
  /// Selfie tirada na hora (CameraCapture, sem upload de galeria) — mesmo
  /// motivo do extras-app: a cooperativa precisa saber que é uma foto
  /// atual de verdade, não uma foto de anos atrás.
  fotoPerfilUrl            String?
  /// CNH aceita foto ao vivo OU anexo de arquivo — ao contrário da selfie,
  /// que é sempre ao vivo (decisão confirmada com o Thiago).
  cnhFotoUrl               String?
  senhaHash                String?
  emailVerificadoEm        DateTime?
  /// Preenchido na criação pra quem se cadastra pelo link específico da
  /// cooperativa (convite implícito) ou é cadastrado manualmente por ela
  /// — fica null pra quem "pede vaga" sem link, desde o cadastro até a
  /// cooperativa escolhida aprovar (ver solicitarVagaMotoboy e
  /// escolherCooperativaMotoboy). Enquanto null, consegue logar (o app
  /// mostra a tela de escolher/aguardar cooperativa em vez do normal),
  /// mas não usa nada do sistema de verdade. Aparece no painel da
  /// cooperativa escolhida como solicitação pendente até aprovar/recusar.
  aprovadoEm               DateTime?
  /// Mostrado ao lado do nome dele em toda tela (painel e portal do
  /// cliente) — null = ainda não informado.
  tipoEquipamento          TipoEquipamento?
  frequenciaPagamento      FrequenciaPagamento   @default(SEMANAL)
  /// true = pode iniciar turno em qualquer Cliente ativo da cooperativa,
  /// sem precisar de liberação individual em MotoboyCliente. Não confundir
  /// com ehGestor — são independentes (um motoboy pode ser as duas coisas,
  /// nenhuma ou só uma).
  livre                    Boolean               @default(false)
  /// Gestor de campo: responsável por até N clientes específicos (ver
  /// MotoboyCliente.gestor), com acesso a um painel próprio e restrito
  /// (dashboard/escala/equipe só dos clientes dele). Ao virar true a
  /// primeira vez, o sistema cria um login de painel pareado (ver
  /// Usuario.motoboyVinculadoId) — dois logins de verdade, ligados, não
  /// uma sessão só (propositalmente: nunca misturar auth de painel com
  /// auth de motoboy).
  ehGestor                 Boolean               @default(false)
  /// Como as bandas que ELE MESMO faz (não como gestor, como motoboy de
  /// verdade) são remuneradas — só relevante se ehGestor. PADRAO usa a
  /// mesma tarifa de qualquer motoboy; VALOR_ESPECIAL usa
  /// valorBandaGestorEspecial; NAO_CONTABILIZA conta a banda (aparece nas
  /// estatísticas) mas não gera valor a pagar.
  modoRemuneracaoGestor    ModoRemuneracaoGestor @default(PADRAO)
  valorBandaGestorEspecial Decimal?              @db.Decimal(10, 2)
  /// Liga o desconto automático de atraso pra esse motoboy (ver
  /// Empresa.toleranciaAtrasoMinutos e DescontoAssiduidade) — desligado
  /// por padrão, cada motoboy precisa ser marcado explicitamente.
  descontoAssiduidadeAtivo Boolean               @default(false)
  ativo                    Boolean               @default(true)
  criadoEm                 DateTime              @default(now())

  empresa              Empresa?                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioGestor        Usuario?
  clientesLiberados    MotoboyCliente[]
  turnos               Turno[]
  pagamentos           Pagamento[]
  vales                Vale[]
  metas                Meta[]
  sessoes              SessaoMotoboy[]
  tokensAutenticacao   TokenAutenticacaoMotoboy[]
  escalas              EscalaTurno[]
  avaliacoes           Avaliacao[]
  avaliacoesFeitas     AvaliacaoCliente[]
  ocorrencias          Ocorrencia[]
  notificacoes         Notificacao[]
  descontosAssiduidade DescontoAssiduidade[]

  @@index([empresaId])
}

enum TipoNotificacao {
  ESCALADO
}

/// Aviso pro motoboy dentro do app (sino/lista) — hoje só "você foi
/// escalado", pensado pra crescer (outros tipos, e futuramente também
/// mandar por e-mail, ver comentário no cadastro de Escala).
model Notificacao {
  id        Int             @id @default(autoincrement())
  motoboyId Int
  tipo      TipoNotificacao
  mensagem  String
  lida      Boolean         @default(false)
  criadoEm  DateTime        @default(now())

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)

  @@index([motoboyId, lida])
}

/// Sessão de login do Motoboy no app — separada de Sessao (login do
/// painel), mesmo espírito de SessaoPessoa no extras-app.
model SessaoMotoboy {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  motoboyId Int
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
}

/// Token de uso único (verificação de e-mail / recuperação de senha) do
/// Motoboy — espelha TokenAutenticacaoPessoa do extras-app.
model TokenAutenticacaoMotoboy {
  id        Int                   @id @default(autoincrement())
  token     String                @unique
  motoboyId Int
  tipo      TipoTokenAutenticacao
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime              @default(now())

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)

  @@index([motoboyId, tipo])
}

/// Autorização explícita: este motoboy pode iniciar turno neste Cliente.
/// Diferente do extras-app (vínculo aberto, criado no primeiro check-in),
/// aqui a cooperativa precisa liberar antes — decisão confirmada com o
/// Thiago. Não existe linha aqui = não autorizado (a não ser que
/// Motoboy.livre seja true).
model MotoboyCliente {
  id        Int      @id @default(autoincrement())
  motoboyId Int
  clienteId Int
  liberado  Boolean  @default(true)
  /// Esse motoboy é Gestor responsável por esse cliente específico — no
  /// máximo 2 por cliente (checado na action, não dá pra fazer via
  /// constraint simples do banco). Só motoboy com Motoboy.ehGestor true
  /// pode ter alguma linha com gestor true.
  gestor    Boolean  @default(false)
  criadoEm  DateTime @default(now())

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([motoboyId, clienteId])
  @@index([clienteId, gestor])
}

/// Um turno do motoboy num Cliente: foto+assinatura de início, foto+
/// assinatura de recibo no fim, quantidade de bandas (stepper +/- na UI)
/// e taxas extras (uma quantidade por faixa do Cliente, ver
/// TurnoTaxaExtraItem) informadas no fechamento. valorBandaAplicado é o
/// snapshot do valor no momento do fechamento — não recalcula se o preço
/// do Cliente mudar depois (mesmo motivo do extras-app: histórico não
/// pode mudar retroativamente). quantidadeTaxasExtras/Cliente aqui são só
/// a SOMA de todas as faixas, guardada pra exibição rápida e pra sinalizar
/// divergência sem precisar somar os itens toda hora — o valor de
/// verdade (pra pagamento) vem de TurnoTaxaExtraItem.
///
/// Existe também um índice único parcial só no banco (Prisma não modela
/// unique parcial em schema.prisma), criado na migration
/// 20260904220000_turno_aberto_unico: `UNIQUE (motoboyId) WHERE status =
/// 'ABERTO'` — garante que um motoboy nunca tenha dois turnos abertos ao
/// mesmo tempo, mesmo com requisições concorrentes (ver comentário em
/// iniciarTurno, turno/iniciar/actions.ts).
model Turno {
  id                    Int              @id @default(autoincrement())
  motoboyId             Int
  clienteId             Int
  turnoPredefinido      TurnoPredefinido @default(LIVRE)
  horaInicio            DateTime         @default(now())
  horaFim               DateTime?
  fotoInicioUrl         String
  fotoFimUrl            String?
  assinaturaTermoUrl    String
  assinaturaReciboUrl   String?
  quantidadeBandas      Int              @default(0)
  quantidadeTaxasExtras Int              @default(0)
  valorBandaAplicado    Decimal?         @db.Decimal(10, 2)
  /// O que o MOTOBOY recebe (sempre existiu). valorCobradoCliente é o que
  /// a COOPERATIVA cobra da empresa cliente por esse turno — pode ser
  /// maior (margem da cooperativa); ver src/lib/precificacao.ts.
  valorTotal            Decimal?         @db.Decimal(10, 2)
  valorCobradoCliente   Decimal?         @db.Decimal(10, 2)
  status                StatusTurno      @default(ABERTO)
  pagamentoId           Int?
  criadoEm              DateTime         @default(now())

  /// Contagem que o CLIENTE (restaurante) informa pelo portal ao
  /// encerrar o motoboy do lado dele — null enquanto ele não fechou.
  /// Quando os dois números não batem (quantidadeBandas do motoboy vs.
  /// quantidadeBandasCliente, ou qualquer item de taxa extra), o turno
  /// fica marcado como divergente até a cooperativa resolver manualmente
  /// (ver resolvidoDivergenciaEm) — decisão confirmada com o Thiago: os
  /// dois têm que bater, não é o registro de um lado que automaticamente
  /// vale mais que o outro.
  quantidadeBandasCliente         Int?
  quantidadeTaxasExtrasCliente    Int?
  /// Preenchido quando a cooperativa resolve manualmente uma divergência
  /// (ou confirma que os números batem) — enquanto null e os dois
  /// números existirem e forem diferentes, o turno aparece na tela de
  /// divergências do painel. Uma vez preenchido, fica pra sempre (não tem
  /// "reabrir divergência") — é o registro permanente de que a
  /// cooperativa e o cliente entraram em acordo sobre esse turno.
  resolvidoDivergenciaEm          DateTime?
  /// Snapshot do que o motoboy tinha informado originalmente, tirado no
  /// momento da resolução — depois disso quantidadeBandas passa a valer
  /// o número combinado (usado no pagamento), então sem isso o número
  /// original do motoboy se perderia (o do cliente já fica preservado em
  /// quantidadeBandasCliente, que nunca é sobrescrito).
  quantidadeBandasMotoboyOriginal Int?
  /// Quem da cooperativa resolveu a divergência — junto com
  /// resolvidoDivergenciaEm e observacaoDivergencia, é o registro de que
  /// a disputa foi resolvida em comum acordo, não decidida sozinha.
  resolvidoPorUsuarioId           Int?
  /// Explicação livre e opcional do acordo (ex.: "cliente contou errado,
  /// motoboy tinha razão") — só preenchido na resolução da divergência.
  observacaoDivergencia           String?

  motoboy             Motoboy              @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  cliente             Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pagamento           Pagamento?           @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)
  resolvidoPorUsuario Usuario?             @relation("TurnoResolvidoPor", fields: [resolvidoPorUsuarioId], references: [id])
  apoios              Apoio[]
  escalas             EscalaTurno[]
  avaliacao           Avaliacao?
  avaliacaoCliente    AvaliacaoCliente?
  ocorrencia          Ocorrencia?
  taxaExtraItens      TurnoTaxaExtraItem[]
  descontoAssiduidade DescontoAssiduidade?

  @@index([motoboyId, status])
  @@index([clienteId, status])
}

/// Desconto automático por atraso no check-in (ver
/// Motoboy.descontoAssiduidadeAtivo e Empresa.toleranciaAtrasoMinutos) —
/// criado sozinho quando o motoboy inicia o turno atrasado, sem depender
/// de ninguém reportar nada. Tabela própria (não reaproveita Ocorrencia)
/// porque Ocorrencia.turnoId é único (um turno só pode ter uma), e o
/// mesmo turno pode ao mesmo tempo ter uma ocorrência de verdade
/// reportada pelo cliente — as duas coisas não podem competir pela mesma
/// linha.
model DescontoAssiduidade {
  id            Int      @id @default(autoincrement())
  turnoId       Int      @unique
  motoboyId     Int
  minutosAtraso Int
  valorDesconto Decimal  @db.Decimal(10, 2)
  pagamentoId   Int?
  criadoEm      DateTime @default(now())

  turno     Turno      @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  motoboy   Motoboy    @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  pagamento Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)

  @@index([motoboyId])
}

/// Quantidade de um turno numa faixa de taxa extra específica do Cliente
/// — um TurnoTaxaExtraItem por faixa ativa do Cliente no momento em que o
/// motoboy encerrou o turno (mesmo as com quantidade 0, pra sempre existir
/// um "slot" que o portal do cliente possa preencher depois). Os valores
/// aqui são snapshot (não mudam se a faixa do Cliente for editada depois).
model TurnoTaxaExtraItem {
  id                        Int      @id @default(autoincrement())
  turnoId                   Int
  /// Referência à faixa de origem — só pra rastreabilidade; null se a
  /// faixa foi apagada do Cliente depois (o snapshot abaixo continua
  /// valendo pro histórico).
  clienteTaxaExtraId        Int?
  ordem                     Int
  descricao                 String
  valorMotoboyAplicado      Decimal  @db.Decimal(10, 2)
  valorClienteAplicado      Decimal  @db.Decimal(10, 2)
  /// Quantidade que o MOTOBOY informou ao encerrar o turno.
  quantidade                Int      @default(0)
  /// Quantidade que o CLIENTE informou pelo portal — null enquanto ele
  /// não fechou o turno do lado dele.
  quantidadeCliente         Int?
  /// Snapshot do que o motoboy tinha informado originalmente nessa faixa,
  /// tirado só quando a cooperativa resolve uma divergência (ver
  /// Turno.quantidadeBandasMotoboyOriginal — mesmo motivo).
  quantidadeMotoboyOriginal Int?
  criadoEm                  DateTime @default(now())

  turno            Turno             @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  clienteTaxaExtra ClienteTaxaExtra? @relation(fields: [clienteTaxaExtraId], references: [id], onDelete: SetNull)

  @@index([turnoId])
}

/// Avaliação do motoboy pelo cliente (restaurante) ao encerrar o turno
/// dele do lado do portal — nota de 1 a 5 + comentário livre opcional,
/// pra registrar qualquer ocorrência.
model Avaliacao {
  id         Int      @id @default(autoincrement())
  turnoId    Int      @unique
  clienteId  Int
  motoboyId  Int
  nota       Int
  comentario String?
  criadoEm   DateTime @default(now())

  turno   Turno   @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)

  @@index([motoboyId])
}

/// Avaliação do cliente (restaurante) pelo motoboy ao encerrar o turno do
/// lado do app dele — sentido inverso de Avaliacao (que é o cliente
/// avaliando o motoboy). Mesmo formato: nota de 1 a 5 + comentário livre
/// opcional, pra registrar como foi o atendimento recebido naquele turno.
model AvaliacaoCliente {
  id         Int      @id @default(autoincrement())
  turnoId    Int      @unique
  clienteId  Int
  motoboyId  Int
  nota       Int
  comentario String?
  criadoEm   DateTime @default(now())

  turno   Turno   @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

/// Ocorrência registrada pelo cliente ao encerrar o turno do motoboy —
/// pedido com problema, cobrança não feita, dinheiro não devolvido,
/// entrega que chegou errada por responsabilidade dele etc. A descrição
/// é o log do motivo; valorDesconto é abatido de verdade do que o
/// motoboy recebe (ver fecharPagamento em
/// src/app/(painel)/pagamentos/actions.ts) — diferente da Avaliação
/// (nota/comentário), que é só histórico e não mexe em dinheiro.
model Ocorrencia {
  id            Int      @id @default(autoincrement())
  turnoId       Int      @unique
  clienteId     Int
  motoboyId     Int
  descricao     String   @db.Text
  valorDesconto Decimal  @db.Decimal(10, 2)
  pagamentoId   Int?
  criadoEm      DateTime @default(now())

  turno     Turno      @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motoboy   Motoboy    @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  pagamento Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)

  @@index([motoboyId])
}

enum StatusSolicitacaoApoio {
  PENDENTE
  A_CAMINHO
  SEM_MOTO
}

/// Pedido de apoio feito pelo cliente direto no portal — a cooperativa
/// vê isso na hora no painel (alerta) e responde com um dos dois botões.
model SolicitacaoApoio {
  id                     Int                    @id @default(autoincrement())
  clienteId              Int
  quantidade             Int
  status                 StatusSolicitacaoApoio @default(PENDENTE)
  respondidoPorUsuarioId Int?
  respondidoEm           DateTime?
  criadoEm               DateTime               @default(now())

  cliente              Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  respondidoPorUsuario Usuario? @relation(fields: [respondidoPorUsuarioId], references: [id])

  @@index([clienteId, status])
}

/// Apoio: o motoboy ajuda outro Cliente durante/depois do turno principal.
/// Sem foto/assinatura de propósito (decisão confirmada com o Thiago) —
/// só marca o Cliente de apoio e a quantidade, pra não atrapalhar o fluxo
/// dele no meio da correria. Taxa extra vem da lista de faixas do Cliente
/// de apoio (ver ApoioTaxaExtraItem) — sem lado "cliente confirma"
/// separado, diferente do Turno principal, porque apoio não passa pelo
/// portal do cliente.
model Apoio {
  id                    Int      @id @default(autoincrement())
  turnoId               Int
  clienteId             Int
  quantidadeBandas      Int      @default(0)
  quantidadeTaxasExtras Int      @default(0)
  valorBandaAplicado    Decimal  @db.Decimal(10, 2)
  valorTotal            Decimal  @db.Decimal(10, 2)
  valorCobradoCliente   Decimal  @default(0) @db.Decimal(10, 2)
  pagamentoId           Int?
  criadoEm              DateTime @default(now())

  turno          Turno                @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  cliente        Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pagamento      Pagamento?           @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)
  taxaExtraItens ApoioTaxaExtraItem[]

  @@index([turnoId])
}

/// Quantidade de um apoio numa faixa de taxa extra do Cliente de apoio —
/// espelha TurnoTaxaExtraItem, mas sem `quantidadeCliente` (apoio não tem
/// confirmação pelo portal).
model ApoioTaxaExtraItem {
  id                   Int      @id @default(autoincrement())
  apoioId              Int
  clienteTaxaExtraId   Int?
  ordem                Int
  descricao            String
  valorMotoboyAplicado Decimal  @db.Decimal(10, 2)
  valorClienteAplicado Decimal  @db.Decimal(10, 2)
  quantidade           Int      @default(0)
  criadoEm             DateTime @default(now())

  apoio            Apoio             @relation(fields: [apoioId], references: [id], onDelete: Cascade)
  clienteTaxaExtra ClienteTaxaExtra? @relation(fields: [clienteTaxaExtraId], references: [id], onDelete: SetNull)

  @@index([apoioId])
}

/// Pagamento de um período pra um motoboy — bookkeeping manual (a
/// cooperativa faz o PIX pelo banco dela e marca aqui como pago), mesmo
/// modelo do extras-app: sem integração PIX automática no MVP.
model Pagamento {
  id            Int             @id @default(autoincrement())
  motoboyId     Int
  empresaId     Int
  periodoInicio DateTime        @db.Date
  periodoFim    DateTime        @db.Date
  valorTotal    Decimal         @db.Decimal(10, 2)
  status        StatusPagamento @default(PENDENTE)
  pagoEm        DateTime?
  criadoEm      DateTime        @default(now())

  motoboy              Motoboy               @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  empresa              Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  turnos               Turno[]
  apoios               Apoio[]
  ocorrencias          Ocorrencia[]
  descontosAssiduidade DescontoAssiduidade[]

  @@index([motoboyId, status])
}

/// Vale (adiantamento) dado pela cooperativa a um motoboy — aparece no app
/// dele como valor a compensar no próximo pagamento.
model Vale {
  id                 Int       @id @default(autoincrement())
  motoboyId          Int
  empresaId          Int
  valor              Decimal   @db.Decimal(10, 2)
  data               DateTime  @default(now()) @db.Date
  observacao         String?
  /// Preenchido quando a cooperativa já compensou esse vale no pagamento
  /// (manualmente — não há vínculo automático com Pagamento nesta fase).
  descontadoEm       DateTime?
  criadoPorUsuarioId Int
  criadoEm           DateTime  @default(now())

  motoboy          Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)
  empresa          Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  criadoPorUsuario Usuario @relation(fields: [criadoPorUsuarioId], references: [id])

  @@index([motoboyId])
}

/// Meta pessoal do motoboy (bandas ou valor-alvo num período) — puramente
/// motivacional, sem efeito em pagamento. Progresso calculado a partir de
/// Turno+Apoio no período, não armazenado aqui.
model Meta {
  id            Int         @id @default(autoincrement())
  motoboyId     Int
  tipo          TipoMeta
  valorAlvo     Decimal     @db.Decimal(10, 2)
  periodoTipo   PeriodoMeta @default(SEMANAL)
  periodoInicio DateTime    @db.Date
  periodoFim    DateTime    @db.Date
  ativa         Boolean     @default(true)
  criadoEm      DateTime    @default(now())

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)

  @@index([motoboyId, ativa])
}

/// Pedido de contato feito na landing page comercial (raiz do domínio) por
/// alguém interessado em usar o ConectaLog na própria cooperativa — não é
/// tenant nenhum ainda, só um lead. Fica salvo aqui além de mandar e-mail
/// de aviso, porque e-mail se perde na caixa de entrada; aqui sempre dá
/// pra ver a lista completa de quem pediu contato.
model LeadComercial {
  id       Int      @id @default(autoincrement())
  nome     String
  contato  String
  mensagem String?
  criadoEm DateTime @default(now())
}
